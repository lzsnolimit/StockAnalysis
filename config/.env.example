# Copy this file to `.env` at project root and fill values.

# OpenAI / LLM
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Stock provider (default yfinance)
STOCK_API_PROVIDER=yfinance

# Optional provider keys
ALPHAVANTAGE_API_KEY=
FINNHUB_TOKEN=
FMP_API_KEY=
IEX_TOKEN=
POLYGON_API_KEY=
TWELVEDATA_API_KEY=

# Email SMTP settings (for Stage 3 alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Subscribers list file
SUBSCRIBERS_FILE=config/subscribers.csv

# SQLite database path
# Preferred DB path key for Stage 3 writer and API
DB_PATH=data/attention.db
# Backward compatible key also respected
# SQLITE_PATH=data/attention.db
